<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ════════════════════════════════════════════════════════ -->
        <!-- 화면 0 : 메인                                            -->
        <!-- ════════════════════════════════════════════════════════ -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="60dp"
                android:paddingBottom="36dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="서울2033 리더"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/kopub_batang"
                    android:textColor="#EEEEEE"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="게임 화면 위에 플로팅 버튼을 표시하고&#10;버튼을 탭하면 나무위키로 연결합니다."
                    android:textSize="13sp"
                    android:fontFamily="@font/kopub_batang"
                    android:textColor="#666666"
                    android:gravity="center"
                    android:layout_marginBottom="40dp"/>

                <!-- 상태 카드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/status_card"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="상태"
                        android:textSize="10sp"
                        android:fontFamily="@font/kopub_batang"
                        android:textColor="#444444"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="확인 중..."
                        android:textSize="14sp"
                        android:fontFamily="@font/kopub_batang"
                        android:textColor="#BBBBBB"
                        android:lineSpacingExtra="6dp"/>

                </LinearLayout>

                <!-- 자동 시작 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/status_card"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/kopub_batang"
                            android:text="서울2033 실행 시 자동 시작"
                            android:textColor="#BBBBBB"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/kopub_batang"
                            android:text="게임 실행 시 오버레이를 자동으로 켭니다. (아래로 드래그하면 버튼을 끌 수 있습니다.)"
                            android:textColor="#555555"
                            android:textSize="11sp"/>

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutoStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"/>

                </LinearLayout>

                <!-- 권한 버튼 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <Button
                        android:id="@+id/btnRequestOverlay"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="오버레이 권한"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp"
                        android:background="@drawable/btn_secondary"
                        android:stateListAnimator="@null"/>

                    <Button
                        android:id="@+id/btnRequestAccessibility"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="접근성 서비스"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp"
                        android:background="@drawable/btn_secondary"
                        android:stateListAnimator="@null"/>

                </LinearLayout>

                <!-- 시작 -->
                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="오버레이 시작"
                    android:textColor="#EEEEEE"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="10dp"/>

                <!-- 중지 -->
                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="중지"
                    android:textColor="#999999"
                    android:textSize="13sp"
                    android:background="@drawable/btn_stop"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="10dp"/>

                <!-- 설정 + 도움말 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="36dp">

                    <Button
                        android:id="@+id/btnSettings"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="설정"
                        android:textColor="#999999"
                        android:textSize="13sp"
                        android:background="@drawable/btn_stop"
                        android:stateListAnimator="@null"/>

                    <Button
                        android:id="@+id/btnHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:paddingHorizontal="20dp"
                        android:text="도움말"
                        android:textColor="#777777"
                        android:textSize="13sp"
                        android:background="@drawable/btn_stop"
                        android:stateListAnimator="@null"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ════════════════════════════════════════════════════════ -->
        <!-- 화면 1 : 설정                                            -->
        <!-- ════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 설정 상단 바 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:background="#111111">

                <TextView
                    android:id="@+id/btnSettingsBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="←"
                    android:textSize="22sp"
                    android:textColor="#AAAAAA"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="뒤로"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="설정"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/kopub_batang"
                    android:textColor="#EEEEEE"
                    android:paddingStart="4dp"/>

            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="48dp">

                    <!-- 섹션 레이블: 버튼 위치 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="버튼 위치"
                        android:textSize="10sp"
                        android:fontFamily="@font/kopub_batang"
                        android:textColor="#444444"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="10dp"/>

                    <Button
                        android:id="@+id/btnSavePosition"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="현재 버튼 위치 기억"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp"
                        android:background="@drawable/btn_secondary"
                        android:stateListAnimator="@null"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/btnResetPosition"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="버튼 위치 초기화"
                        android:textColor="#999999"
                        android:textSize="13sp"
                        android:background="@drawable/btn_stop"
                        android:stateListAnimator="@null"
                        android:layout_marginBottom="28dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1E1E1E"
                        android:layout_marginBottom="28dp"/>

                    <!-- 섹션 레이블: 웹뷰 투명도 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="웹뷰 투명도"
                        android:textSize="10sp"
                        android:fontFamily="@font/kopub_batang"
                        android:textColor="#444444"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="10dp"/>

                    <!-- 터치 ON일 때 투명도 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/status_card"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="14dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvAlphaOnLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="터치 ON일 때: 100%"
                            android:textColor="#BBBBBB"
                            android:textSize="14sp"
                            android:fontFamily="@font/kopub_batang"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="웹뷰를 직접 조작할 때의 투명도입니다."
                            android:textColor="#555555"
                            android:textSize="11sp"
                            android:fontFamily="@font/kopub_batang"
                            android:layout_marginBottom="12dp"/>

                        <SeekBar
                            android:id="@+id/seekAlphaOn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"/>

                    </LinearLayout>

                    <!-- 터치 OFF일 때 투명도 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/status_card"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="14dp"
                        android:layout_marginBottom="28dp">

                        <TextView
                            android:id="@+id/tvAlphaOffLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="터치 OFF일 때: 60%"
                            android:textColor="#BBBBBB"
                            android:textSize="14sp"
                            android:fontFamily="@font/kopub_batang"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="터치가 게임으로 통과될 때의 투명도입니다. 낮을수록 게임 화면이 잘 보입니다."
                            android:textColor="#555555"
                            android:textSize="11sp"
                            android:fontFamily="@font/kopub_batang"
                            android:layout_marginBottom="12dp"/>

                        <SeekBar
                            android:id="@+id/seekAlphaOff"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"/>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1E1E1E"
                        android:layout_marginBottom="28dp"/>

                    <!-- 예시 보기 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="미리 보기"
                        android:textSize="10sp"
                        android:fontFamily="@font/kopub_batang"
                        android:textColor="#444444"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="10dp"/>

                    <Button
                        android:id="@+id/btnShowExample"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="예시 팝업 보기"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp"
                        android:background="@drawable/btn_secondary"
                        android:stateListAnimator="@null"/>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- ════════════════════════════════════════════════════════ -->
        <!-- 화면 2 : 도움말                                          -->
        <!-- ════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 도움말 상단 바 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:background="#111111">

                <TextView
                    android:id="@+id/btnHelpBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="←"
                    android:textSize="22sp"
                    android:textColor="#AAAAAA"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="뒤로"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="도움말"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/kopub_batang"
                    android:textColor="#EEEEEE"
                    android:paddingStart="4dp"/>

            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="48dp">

                    <!-- 기본 사용법 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="기본 사용법"
                        android:textSize="10sp"
                        android:fontFamily="@font/kopub_batang"
                        android:textColor="#444444"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/status_card"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1. 오버레이 권한과 접근성 서비스를 허용합니다.\n2. [오버레이 시작]을 누르면 게임 화면 위에 Read 버튼이 나타납니다.\n3. 서울2033 인카운터 화면에서 Read 버튼을 탭하면 나무위키 항목을 찾아줍니다."
                            android:textColor="#AAAAAA"
                            android:textSize="13sp"
                            android:fontFamily="@font/kopub_batang"
                            android:lineSpacingExtra="4dp"/>

                    </LinearLayout>

                    <!-- 웹뷰 팝업 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="웹뷰 팝업"
                        android:textSize="10sp"
                        android:fontFamily="@font/kopub_batang"
                        android:textColor="#444444"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/status_card"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• 상단 바를 드래그해서 팝업을 이동할 수 있습니다.\n• 오른쪽 가장자리로 드래그하면 peek 모드로 접혀 게임 화면을 가리지 않습니다.\n• peek 상태에서 탭하면 다시 펼쳐집니다."
                            android:textColor="#AAAAAA"
                            android:textSize="13sp"
                            android:fontFamily="@font/kopub_batang"
                            android:lineSpacingExtra="4dp"/>

                    </LinearLayout>

                    <!-- 터치 ON/OFF -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="터치 ON / OFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/kopub_batang"
                        android:textColor="#444444"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/status_card"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• 터치 OFF 상태에서는 웹뷰 본문 영역을 탭해도 게임 화면에 터치가 전달됩니다.\n• 상단 바의 [터치 ON/OFF] 버튼으로 전환할 수 있습니다.\n• 터치 ON/OFF에 따라 설정한 투명도가 자동으로 적용됩니다."
                            android:textColor="#AAAAAA"
                            android:textSize="13sp"
                            android:fontFamily="@font/kopub_batang"
                            android:lineSpacingExtra="4dp"/>

                    </LinearLayout>

                    <!-- 버튼 위치 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="버튼 위치"
                        android:textSize="10sp"
                        android:fontFamily="@font/kopub_batang"
                        android:textColor="#444444"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/status_card"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• Read 버튼을 원하는 위치로 드래그한 뒤 [설정 → 현재 버튼 위치 기억]을 누르면 앱 재시작 후에도 유지됩니다.\n• [버튼 위치 초기화]를 누르면 상단 가운데로 돌아갑니다."
                            android:textColor="#AAAAAA"
                            android:textSize="13sp"
                            android:fontFamily="@font/kopub_batang"
                            android:lineSpacingExtra="4dp"/>

                    </LinearLayout>

                    <!-- 자동 시작 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="자동 시작"
                        android:textSize="10sp"
                        android:fontFamily="@font/kopub_batang"
                        android:textColor="#444444"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/status_card"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="켜두면 서울2033 실행 시 자동으로 오버레이가 시작되고, 종료 시 자동으로 꺼집니다."
                            android:textColor="#AAAAAA"
                            android:textSize="13sp"
                            android:fontFamily="@font/kopub_batang"
                            android:lineSpacingExtra="4dp"/>

                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

    </ViewFlipper>

</FrameLayout>
